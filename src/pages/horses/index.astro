---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HorseCard from '../../components/HorseCard.astro';

const horses = (await getCollection('horses')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
---

<BaseLayout title="Horses" description="The horses — breed, discipline, and their stories.">
  <section class="mx-auto max-w-6xl px-5 py-10 sm:py-14">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Horses</h1>
    <p class="mt-2 max-w-2xl text-muted">
      The string &mdash; tap a horse for their story, results, and photos.
    </p>

    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {horses.map((horse) => <HorseCard horse={horse} />)}
    </div>
  </section>
</BaseLayout>
