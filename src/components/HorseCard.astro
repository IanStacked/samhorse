---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { horseAge } from '../site';

interface Props {
  horse: CollectionEntry<'horses'>;
}

const { horse } = Astro.props;
const { name, breed, discipline, foaled, photo } = horse.data;
---

<a href={`/horses/${horse.id}`} class="group block">
  <div class="aspect-[3/2] overflow-hidden rounded-xl bg-mist">
    <Image
      src={photo}
      alt={`${name}, a ${breed}`}
      widths={[320, 640, 960]}
      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
    />
  </div>
  <div class="mt-3">
    <h3 class="text-lg font-semibold tracking-tight group-hover:text-accent">{name}</h3>
    <p class="text-sm text-accent">{discipline}</p>
    <p class="text-sm text-muted">{breed} &middot; {horseAge(foaled)} yrs</p>
  </div>
</a>
