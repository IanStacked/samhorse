---
import type { TournamentItem } from '../types';

interface Props {
  items: TournamentItem[];
  showHorse?: boolean;
}

const { items, showHorse = true } = Astro.props;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<ul class="divide-y divide-mist border-y border-mist">
  {
    items.map((t) => (
      <li>
        <a
          href={`/tournaments/${t.id}`}
          class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
        >
          <div>
            <p class="font-medium group-hover:text-accent">{t.name}</p>
            <p class="text-sm text-muted">
              <time datetime={t.date.toISOString()}>{fmtDate(t.date)}</time> &middot; {t.location}
              {showHorse && t.horseName && <> &middot; {t.horseName}</>}
            </p>
          </div>
          <span class="shrink-0 self-start rounded-full bg-mist px-3 py-1 text-sm font-medium text-ink sm:self-auto">
            {t.placement}
          </span>
        </a>
      </li>
    ))
  }
</ul>
